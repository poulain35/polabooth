<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0-windows pour pouvoir référencer PolaKiosk (WPF + System.Printing) -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 : les projets de test sont des exécutables autonomes -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PolaKiosk\PolaKiosk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Cas de test communs SaaS / borne (plan des écrans composés, états des écrans, montage du
       tirage) : lus à leur place, jamais copiés -->
  <ItemGroup>
    <None Include="..\..\docs\specs\fixtures\kiosk-screen-layout-cases.json"
          Link="Fixtures\kiosk-screen-layout-cases.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\specs\fixtures\kiosk-screen-state-cases.json"
          Link="Fixtures\kiosk-screen-state-cases.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\specs\fixtures\kiosk-composite-cases.json"
          Link="Fixtures\kiosk-composite-cases.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Une vraie police TrueType pour les textes vivants (LAB-331) : celle de l'application -->
    <None Include="..\PolaKiosk\Assets\Fonts\Fraunces72ptSuperSoft-SemiBold.ttf"
          Link="Fixtures\fonts\Fraunces72ptSuperSoft-SemiBold.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>