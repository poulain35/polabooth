<UserControl x:Class="PolaKiosk.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Carte de réglage sur fond sombre -->
        <Style x:Key="AdminCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource KioskOnDarkSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource KioskOnDarkLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource KioskTileRadius}"/>
            <Setter Property="Padding" Value="28,22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Titre de carte -->
        <Style x:Key="AdminCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource KioskOnDarkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Texte d'aide et messages d'état -->
        <Style x:Key="AdminHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource KioskOnDarkMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Geometry x:Key="IconCheck">M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</Geometry>

        <!-- Case à cocher d'une carte : 28 px, contour clair, coche sombre sur fond vert d'eau -->
        <Style x:Key="AdminCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource KioskOnDarkBrush}"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="box" Width="28" Height="28" CornerRadius="7" VerticalAlignment="Center"
                                    BorderThickness="2" BorderBrush="{StaticResource KioskOnDarkBrush}" Background="Transparent">
                                <Path x:Name="tick" Data="{StaticResource IconCheck}" Fill="{StaticResource KioskDarkBrush}"
                                      Stretch="Uniform" Width="16" Height="16" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource KioskMintBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource KioskMintBrush}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton d'action d'une carte : vert d'eau, compact mais ≥ 48 px de haut -->
        <Style x:Key="AdminButton" TargetType="Button" BasedOn="{StaticResource KioskSecondaryButton}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="MinHeight" Value="48"/>
        </Style>
    </UserControl.Resources>

    <!-- Fond sombre fixe de la borne : réservé à l'équipe, distinct des écrans invités -->
    <Grid Background="{StaticResource KioskDarkBrush}">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40">

            <!-- En-tête -->
            <Grid Margin="0,0,0,40">
                <StackPanel>
                    <!-- Logo du logiciel (Polabooth), version pour fond sombre -->
                    <Image Source="pack://application:,,,/Assets/Brand/polabooth-logo-horizontal-blanc.png"
                           Height="44" HorizontalAlignment="Left" Margin="0,0,0,20"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Administration" Style="{StaticResource KioskTitleText}" FontSize="36"
                               Foreground="{StaticResource KioskOnDarkBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Gestion des événements et paramètres du kiosk"
                               FontSize="16" Foreground="{StaticResource KioskOnDarkMutedBrush}"/>
                </StackPanel>
                <!-- Numéro de version -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{StaticResource KioskOnDarkSurfaceBrush}" CornerRadius="15"
                        BorderBrush="{StaticResource KioskOnDarkLineBrush}" BorderThickness="1" Padding="14,6">
                    <TextBlock Text="{Binding AppVersion}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskOnDarkMutedBrush}"/>
                </Border>
            </Grid>

            <!-- Event actif -->
            <Border Style="{StaticResource AdminCard}">
                <StackPanel>
                    <TextBlock Text="Événement actif" Style="{StaticResource AdminHint}" FontSize="13" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding ActiveEventName}"
                               FontSize="24" FontWeight="SemiBold" FontFamily="{StaticResource KioskTitleFont}"
                               Foreground="{StaticResource KioskOnDarkBrush}"/>
                    <TextBlock Text="{Binding ActiveEventId, StringFormat='ID : {0}'}"
                               Style="{StaticResource AdminHint}" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Import .pola (mode hors ligne) -->
            <Border Style="{StaticResource AdminCard}">
                <StackPanel>
                    <TextBlock Text="Mode hors ligne" Style="{StaticResource AdminCardTitle}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource AdminHint}" Margin="0,0,0,12">
                        Sans connexion internet, importez un fichier <Run FontWeight="Bold">.pola</Run>
                        exporté depuis l'espace admin SaaS. Le client pourra ensuite entrer son code événement.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding ImportPolaFileCommand}"
                                IsEnabled="{Binding IsImporting, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                Style="{StaticResource AdminButton}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="📁 Importer un fichier .pola"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                                <Setter Property="Text" Value="Import en cours..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding PolaStatusMsg}" Style="{StaticResource AdminHint}"
                               Visibility="{Binding PolaStatusMsg, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- .pola déjà importés (LAB-321) : recharger un événement sans le fichier d'origine -->
                    <TextBlock Text=".pola déjà importés" Style="{StaticResource AdminCardTitle}" Margin="0,24,0,4"/>
                    <TextBlock Style="{StaticResource AdminHint}" Margin="0,0,0,12"
                               Text="Les 20 derniers fichiers importés restent sur la borne. « Recharger » refait l'import : l'événement redevient l'événement actif, sans réseau ni clé USB."/>
                    <TextBlock Text="Aucun fichier importé pour l'instant." Style="{StaticResource AdminHint}" FontStyle="Italic"
                               Visibility="{Binding HasPolaHistory, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                    <ItemsControl ItemsSource="{Binding PolaHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource KioskDarkBrush}" BorderBrush="{StaticResource KioskOnDarkLineBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="20,14" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding EventName}" FontSize="20" FontWeight="SemiBold"
                                                       Foreground="{StaticResource KioskOnDarkBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding EventDates}" FontSize="16" Margin="0,4,0,0"
                                                       Foreground="{StaticResource KioskOnDarkBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ImportedText}" Style="{StaticResource AdminHint}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource AdminButton}"
                                                MinHeight="64" MinWidth="180" FontSize="18" VerticalAlignment="Center"
                                                Command="{Binding DataContext.ReloadPolaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="Recharger"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Imprimante -->
            <Border Style="{StaticResource AdminCard}">
                <StackPanel>
                    <TextBlock Text="Imprimante" Style="{StaticResource AdminCardTitle}"/>
                    <TextBlock Text="{Binding DefaultPrinterHint}" Style="{StaticResource AdminHint}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="380" Height="48" VerticalContentAlignment="Center"
                                  FontSize="15" Margin="0,0,12,0"
                                  ItemsSource="{Binding AvailablePrinters}"
                                  SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}"/>
                        <Button Command="{Binding SavePrinterCommand}" Style="{StaticResource AdminButton}"
                                Content="Enregistrer"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PrinterStatusMsg}" Style="{StaticResource AdminHint}" Margin="0,8,0,0"
                               Visibility="{Binding PrinterStatusMsg, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Bandes 5x15 (LAB-334) : réglages du pilote enregistrés une fois depuis sa fenêtre -->
                    <TextBlock Text="Bandes 5x15" Margin="0,22,0,6" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskOnDarkBrush}"/>
                    <TextBlock Style="{StaticResource AdminHint}" Margin="0,0,0,12"
                               Text="Une bande s'imprime deux fois sur une feuille 10x15, que l'imprimante coupe en deux. Enregistrez une fois chaque réglage du pilote de l'imprimante choisie ci-dessus (enregistrez d'abord l'imprimante)."/>

                    <Button Command="{Binding RecordStripCutSettingCommand}" Style="{StaticResource AdminButton}"
                            HorizontalAlignment="Left" Content="Enregistrer le réglage bandes coupées"/>
                    <TextBlock Style="{StaticResource AdminHint}" Margin="0,6,0,4"
                               Text="Dans la fenêtre qui s'ouvre, cochez la coupe 2 pouces (2inch cut) puis validez."/>
                    <TextBlock Text="{Binding StripCutSettingStatus}" Style="{StaticResource AdminHint}" Margin="0,0,0,14"
                               Foreground="{StaticResource KioskOnDarkBrush}"/>

                    <Button Command="{Binding RecordNormalSettingCommand}" Style="{StaticResource AdminButton}"
                            HorizontalAlignment="Left" Content="Enregistrer le réglage normal"/>
                    <TextBlock Style="{StaticResource AdminHint}" Margin="0,6,0,4"
                               Text="Facultatif. Dans la fenêtre qui s'ouvre, vérifiez que la coupe 2 pouces (2inch cut) est décochée puis validez. Sans ce réglage, les 10x15 utilisent le réglage par défaut du pilote."/>
                    <TextBlock Text="{Binding NormalSettingStatus}" Style="{StaticResource AdminHint}"
                               Foreground="{StaticResource KioskOnDarkBrush}"/>

                    <TextBlock Text="{Binding DriverSettingMsg}" Style="{StaticResource AdminHint}" Margin="0,12,0,0"
                               Visibility="{Binding DriverSettingMsg, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Caméra -->
            <Border Style="{StaticResource AdminCard}">
                <StackPanel>
                    <TextBlock Text="Caméra" Style="{StaticResource AdminCardTitle}"/>
                    <TextBlock Text="« Détection automatique » privilégie le Canon, sinon une webcam. Choisissez une source précise si besoin."
                               Style="{StaticResource AdminHint}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="380" Height="48" VerticalContentAlignment="Center"
                                  FontSize="15" Margin="0,0,12,0"
                                  ItemsSource="{Binding AvailableCameras}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"/>
                        <Button Command="{Binding SaveCameraCommand}" Style="{StaticResource AdminButton}"
                                Content="Enregistrer"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CameraStatusMsg}" Style="{StaticResource AdminHint}" Margin="0,8,0,0"
                               Visibility="{Binding CameraStatusMsg, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Tester la caméra (LAB-263) : appareil choisi au démarrage -->
                    <TextBlock Text="Tester l'appareil utilisé par la borne : aperçu en direct puis photo de test."
                               Style="{StaticResource AdminHint}" Margin="0,20,0,12"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Command="{Binding TestCameraCommand}" Style="{StaticResource AdminButton}"
                                Content="Tester la caméra" Margin="0,0,12,8"/>
                        <Button Command="{Binding CaptureTestPhotoCommand}" Style="{StaticResource AdminButton}"
                                Content="Photo de test" Margin="0,0,12,8"/>
                        <!-- Réglages d'exposition du Canon (LAB-427) -->
                        <Button Command="{Binding OpenExposureCommand}" Style="{StaticResource AdminButton}"
                                Content="Appareil photo" Margin="0,0,12,8"/>
                        <Button Command="{Binding StopCameraTestCommand}" Style="{StaticResource AdminButton}"
                                Content="Arrêter l'aperçu" Margin="0,0,12,8"
                                Visibility="{Binding HasTestPreview, Converter={StaticResource BoolToVisibility}}"/>
                    </WrapPanel>
                    <Border CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Background="{StaticResource KioskDarkBrush}" MaxWidth="560"
                            Visibility="{Binding HasTestPreview, Converter={StaticResource BoolToVisibility}}">
                        <Image Source="{Binding TestPreview}" Stretch="Uniform" MaxHeight="315"/>
                    </Border>
                    <TextBlock Text="{Binding CameraTestMsg}" Style="{StaticResource AdminHint}" Margin="0,8,0,0"
                               Visibility="{Binding CameraTestMsg, Converter={StaticResource BoolToVisibility}}"/>
                    <TextBlock Text="{Binding LowDefinitionWarning}" Margin="0,8,0,0" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskErrorOnDarkBrush}" TextWrapping="Wrap"
                               Visibility="{Binding LowDefinitionWarning, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Photos du Canon -->
            <Border Style="{StaticResource AdminCard}">
                <StackPanel>
                    <TextBlock Text="Photos du Canon" Style="{StaticResource AdminCardTitle}"/>
                    <TextBlock Text="Taille des photos prises par le Canon. « Moyenne » suffit largement pour l'impression 10 × 15 et allège le PC ; le montage imprimé et envoyé ne change pas."
                               Style="{StaticResource AdminHint}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="380" Height="48" VerticalContentAlignment="Center"
                                  FontSize="15" Margin="0,0,12,0"
                                  ItemsSource="{Binding PhotoSizes}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedPhotoSize, Mode=TwoWay}"/>
                        <Button Command="{Binding SavePhotoSizeCommand}" Style="{StaticResource AdminButton}"
                                Content="Enregistrer"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PhotoSizeStatusMsg}" Style="{StaticResource AdminHint}" Margin="0,8,0,0"
                               Visibility="{Binding PhotoSizeStatusMsg, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Nettoyage du PC -->
            <Border Style="{StaticResource AdminCard}">
                <StackPanel>
                    <TextBlock Text="Nettoyage du PC" Style="{StaticResource AdminCardTitle}"/>
                    <TextBlock Text="Les photos d'un événement terminé sont supprimées du PC après ce délai, seulement si elles ont toutes été envoyées en ligne. L'événement en cours n'est jamais supprimé."
                               Style="{StaticResource AdminHint}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="380" Height="48" VerticalContentAlignment="Center"
                                  FontSize="15" Margin="0,0,12,0"
                                  ItemsSource="{Binding RetentionOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedRetention, Mode=TwoWay}"/>
                        <Button Command="{Binding SaveRetentionCommand}" Style="{StaticResource AdminButton}"
                                Content="Enregistrer"/>
                    </StackPanel>
                    <TextBlock Text="{Binding RetentionStatusMsg}" Style="{StaticResource AdminHint}" Margin="0,8,0,0"
                               Visibility="{Binding RetentionStatusMsg, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Adresse du SaaS (open core K2) : seulement pour une adresse saisie sur la borne -->
            <Border Style="{StaticResource AdminCard}"
                    Visibility="{Binding CanChangeSaas, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Adresse du SaaS" Style="{StaticResource AdminCardTitle}"/>
                    <TextBlock Text="{Binding SaasAddressText}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskOnDarkBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Changer de SaaS efface aussi l'association de la borne, son PIN admin et l'événement chargé. La borne redémarre sur la saisie de l'adresse, puis l'association."
                               Style="{StaticResource AdminHint}" Margin="0,0,0,12"/>
                    <Button Command="{Binding AskSaasChangeCommand}" Style="{StaticResource AdminButton}"
                            HorizontalAlignment="Left" Content="Changer de SaaS"
                            Visibility="{Binding IsConfirmingSaasChange, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                    <StackPanel Visibility="{Binding IsConfirmingSaasChange, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Confirmer ? La borne devra être associée de nouveau."
                                   FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource KioskOnDarkBrush}"
                                   Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding ConfirmSaasChangeCommand}" Style="{StaticResource AdminButton}"
                                    Margin="0,0,12,0" Content="Oui, changer de SaaS"/>
                            <Button Command="{Binding CancelSaasChangeCommand}" Style="{StaticResource AdminButton}"
                                    Content="Annuler"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding SaasStatusMsg}" Style="{StaticResource AdminHint}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Démarrage de Windows : raccourci du watchdog dans le dossier Démarrage (désactivé par défaut) -->
            <Border Style="{StaticResource AdminCard}">
                <StackPanel>
                    <TextBlock Text="Démarrage de Windows" Style="{StaticResource AdminCardTitle}"/>
                    <TextBlock Text="Cochée, la borne s'ouvre toute seule à chaque démarrage du PC. Décochée, on l'ouvre à la main (icône PolaKiosk du Bureau). Dans les deux cas, elle se relance toute seule après un plantage ou une mise à jour."
                               Style="{StaticResource AdminHint}" Margin="0,0,0,12"/>
                    <CheckBox Style="{StaticResource AdminCheckBox}" HorizontalAlignment="Left"
                              IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"
                              IsEnabled="{Binding CanChangeLaunchAtStartup}"
                              Content="Lancer la borne au démarrage de Windows"/>
                    <TextBlock Text="{Binding LaunchAtStartupStatusMsg}" Style="{StaticResource AdminHint}" Margin="0,8,0,0"
                               Visibility="{Binding LaunchAtStartupStatusMsg, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Quitter vers Windows : sans relance par le watchdog -->
            <Border Style="{StaticResource AdminCard}">
                <StackPanel>
                    <TextBlock Text="Quitter vers Windows" Style="{StaticResource AdminCardTitle}"/>
                    <TextBlock Text="Ferme la borne sans qu'elle se relance toute seule. Elle repart en lançant PolaKiosk à la main, ou au prochain démarrage de Windows si la case ci-dessus est cochée."
                               Style="{StaticResource AdminHint}" Margin="0,0,0,12"/>
                    <Button Command="{Binding AskQuitCommand}" Style="{StaticResource AdminButton}"
                            HorizontalAlignment="Left" Content="Quitter vers Windows"
                            Visibility="{Binding IsConfirmingQuit, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                    <StackPanel Visibility="{Binding IsConfirmingQuit, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Confirmer ? Les invités ne pourront plus utiliser la borne."
                                   FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource KioskOnDarkBrush}"
                                   Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding ConfirmQuitCommand}" Style="{StaticResource AdminButton}"
                                    Margin="0,0,12,0" Content="Oui, quitter"/>
                            <Button Command="{Binding CancelQuitCommand}" Style="{StaticResource AdminButton}"
                                    Content="Annuler"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding QuitStatusMsg}" Style="{StaticResource AdminHint}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <!-- Sur fond sombre, le bouton principal passe en crème (le vert forêt s'y perdrait) -->
                <Button Command="{Binding ChangeEventCommand}" Style="{StaticResource KioskPrimaryButton}"
                        Background="{StaticResource KioskCreamBrush}" Foreground="{StaticResource KioskForestBrush}"
                        FontSize="18" Padding="28,14" Margin="0,0,12,0"
                        Content="Changer d'événement"/>
                <!-- Sur fond sombre, « Retour » garde sa forme mais passe en crème (LAB-256) -->
                <Button Command="{Binding BackCommand}" Style="{StaticResource KioskBackButton}" Height="64"
                        Foreground="{StaticResource KioskOnDarkBrush}" BorderBrush="{StaticResource KioskOnDarkMutedBrush}"/>
            </StackPanel>

        </StackPanel>
        </ScrollViewer>

        <!-- Appareil photo (LAB-427) : vitesse, ouverture, ISO, balance des blancs du Canon, par-dessus
             l'Admin. Aperçu à gauche, réglages à droite (gros boutons − / + pour l'écran tactile). -->
        <Grid Background="{StaticResource KioskDarkBrush}"
              Visibility="{Binding IsExposureOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Titre -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Command="{Binding CloseExposureCommand}"
                            Style="{StaticResource AdminButton}" MinHeight="64" MinWidth="140" Content="Fermer"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Appareil photo" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource KioskOnDarkBrush}"/>
                        <TextBlock Style="{StaticResource AdminHint}"
                                   Visibility="{Binding IsExposureSupported, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="{Binding ExposureModel, Mode=OneWay}"/><Run Text=" · mode "/><Run Text="{Binding ExposureMode, Mode=OneWay}"/><Run Text=" · réglages gardés sur cette borne"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- Bandeau : molette pas sur M -->
                <Border Grid.Row="1" Background="{StaticResource KioskCreamBrush}" CornerRadius="8"
                        Padding="20,14" Margin="0,0,0,12"
                        Visibility="{Binding NeedsManualMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource KioskWarningBrush}">
                        <Run Text="Mettez la molette de l'appareil sur M pour modifier les réglages (mode actuel : "/><Run Text="{Binding ExposureMode, Mode=OneWay}"/><Run Text=")."/>
                    </TextBlock>
                </Border>

                <!-- Aperçu (ou photo de test) et réglages -->
                <Grid Grid.Row="2" Visibility="{Binding IsExposureSupported, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border CornerRadius="8" ClipToBounds="True" Background="{StaticResource KioskOnDarkSurfaceBrush}">
                            <Grid>
                                <Image Source="{Binding TestPreview}" Stretch="Uniform"
                                       Visibility="{Binding HasExposureTestPhoto, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                <Image Source="{Binding ExposureTestPhoto}" Stretch="Uniform"
                                       Visibility="{Binding HasExposureTestPhoto, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource AdminHint}" Margin="0,0,0,10"
                                       Text="L'aperçu n'est pas éclairé comme la photo (flash) : prenez une photo de test pour juger le rendu. Elle n'est ni gardée ni envoyée."/>
                            <WrapPanel>
                                <Button Command="{Binding TakeExposureTestPhotoCommand}" Style="{StaticResource AdminButton}"
                                        MinHeight="80" Margin="0,0,12,0" Content="Prendre une photo de test"
                                        Visibility="{Binding HasExposureTestPhoto, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                <Button Command="{Binding BackToExposurePreviewCommand}" Style="{StaticResource AdminButton}"
                                        MinHeight="80" Margin="0,0,12,0" Content="Revenir à l'aperçu"
                                        Visibility="{Binding HasExposureTestPhoto, Converter={StaticResource BoolToVisibility}}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding ExposureSettings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AdminCard}" Padding="20,14" Margin="0,0,0,12"
                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ValueLabel}" FontSize="24"
                                                           FontWeight="SemiBold" Foreground="{StaticResource KioskOnDarkBrush}"/>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource AdminCardTitle}"
                                                           VerticalAlignment="Center" Margin="0"/>
                                            </DockPanel>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Command="{Binding DecrementCommand}"
                                                        IsEnabled="{Binding CanDecrement}"
                                                        Style="{StaticResource AdminButton}" Width="80" Height="80"
                                                        Padding="0" FontSize="32" Content="−"/>
                                                <Slider Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                                                        Minimum="0" Maximum="{Binding MaxIndex}" TickFrequency="1"
                                                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                                        IsEnabled="{Binding IsEnabled}"
                                                        Value="{Binding SelectedIndex, Mode=TwoWay}"/>
                                                <Button Grid.Column="2" Command="{Binding IncrementCommand}"
                                                        IsEnabled="{Binding CanIncrement}"
                                                        Style="{StaticResource AdminButton}" Width="80" Height="80"
                                                        Padding="0" FontSize="32" Content="+"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Warning}" Margin="0,8,0,0" FontSize="15"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{StaticResource KioskErrorOnDarkBrush}"
                                                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Message (refus de l'appareil, autre caméra, photo de test) -->
                <TextBlock Grid.Row="3" Text="{Binding ExposureMsg}" Margin="0,12,0,0" FontSize="17"
                           FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource KioskOnDarkBrush}"
                           Visibility="{Binding HasExposureMsg, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
