<UserControl x:Class="PolaKiosk.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ManipulationBoundaryFeedback="OnManipulationBoundaryFeedback">
    <!-- Écran tactile (maquette A du 2026-11-19) : menu à gauche, une section à la fois, défilement au
         doigt, gros boutons, choix en tuiles enregistrés dès qu'on les touche. -->
    <UserControl.Resources>
        <!-- Carte de réglage sur fond sombre -->
        <Style x:Key="AdminCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource KioskOnDarkSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource KioskOnDarkLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource KioskTileRadius}"/>
            <Setter Property="Padding" Value="28,24"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Titre de carte -->
        <Style x:Key="AdminCardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource KioskOnDarkBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Texte d'aide -->
        <Style x:Key="AdminHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource KioskOnDarkMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Message d'état (✓ enregistré, ✗ erreur), masqué tant qu'il est vide -->
        <Style x:Key="AdminStatus" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource KioskOnDarkBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="Visibility" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibility}}"/>
        </Style>

        <!-- Titre et sous-titre d'une section -->
        <Style x:Key="AdminSectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource KioskTitleFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource KioskOnDarkBrush}"/>
        </Style>
        <Style x:Key="AdminSectionSubtitle" TargetType="TextBlock" BasedOn="{StaticResource AdminHint}">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Margin" Value="0,6,0,24"/>
        </Style>

        <!-- Zone qui défile au doigt (PanningMode) comme à la souris -->
        <Style x:Key="AdminScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="PanningMode" Value="VerticalOnly"/>
            <Setter Property="PanningDeceleration" Value="0.003"/>
            <Style.Resources>
                <!-- Barre fine et discrète : elle indique qu'il y a une suite, on défile au doigt -->
                <Style TargetType="ScrollBar">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="MinWidth" Value="10"/>
                    <Setter Property="Margin" Value="0,8,6,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border CornerRadius="4" Width="6" Background="{StaticResource KioskOnDarkLineBrush}"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <Geometry x:Key="IconCheck">M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</Geometry>

        <!-- ── Boutons ── -->
        <!-- Action d'une carte : vert d'eau, 64 px de haut au moins -->
        <Style x:Key="AdminButton" TargetType="Button" BasedOn="{StaticResource KioskSecondaryButton}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="26,12"/>
            <Setter Property="MinHeight" Value="64"/>
        </Style>
        <!-- Action principale sur fond sombre : crème (le vert forêt s'y perdrait) -->
        <Style x:Key="AdminPrimaryButton" TargetType="Button" BasedOn="{StaticResource AdminButton}">
            <Setter Property="Background" Value="{StaticResource KioskCreamBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource KioskForestBrush}"/>
        </Style>
        <!-- Action secondaire : contour clair -->
        <Style x:Key="AdminOutlineButton" TargetType="Button" BasedOn="{StaticResource AdminButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource KioskOnDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource KioskOnDarkLineBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <!-- Confirmation d'une action sensible (quitter, changer de SaaS) : rose poudré -->
        <Style x:Key="AdminDangerButton" TargetType="Button" BasedOn="{StaticResource AdminButton}">
            <Setter Property="Background" Value="{StaticResource KioskBlushBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource KioskDarkBrush}"/>
        </Style>
        <!-- Touche du pavé de décalage : 88 px -->
        <Style x:Key="AdminPadButton" TargetType="Button" BasedOn="{StaticResource AdminButton}">
            <Setter Property="Width" Value="88"/>
            <Setter Property="Height" Value="88"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="32"/>
        </Style>

        <!-- Entrée du menu de gauche : crème quand sa section est affichée (Tag = vrai) -->
        <Style x:Key="AdminNavButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="{StaticResource KioskTextFont}"/>
            <Setter Property="Foreground" Value="{StaticResource KioskOnDarkBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="88"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="20"
                                Padding="22,14" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource KioskOnDarkSurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag">
                                <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource KioskCreamBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource KioskForestBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grande tuile d'action (réglages du pilote) : titre, consigne, état -->
        <Style x:Key="AdminActionTile" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FontFamily" Value="{StaticResource KioskTextFont}"/>
            <Setter Property="Foreground" Value="{StaticResource KioskOnDarkBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{StaticResource KioskOnDarkSurfaceBrush}"
                                BorderBrush="{StaticResource KioskOnDarkLineBrush}" BorderThickness="1.5"
                                CornerRadius="20" Padding="22,18" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource KioskMintBrush}"/>
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Choix en tuiles (imprimante, caméra, taille des photos, nettoyage) : une liste sans barre de
             défilement (la page défile), la tuile choisie en crème avec une coche -->
        <Style x:Key="AdminChoiceItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource KioskOnDarkBrush}"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="MaxWidth" Value="440"/>
            <!-- Choisie au relâcher, et seulement si le doigt n'a pas glissé : faire défiler la page en
                 partant d'une tuile ne change pas le réglage (code-behind) -->
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="OnChoicePressed"/>
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnChoiceReleased"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" Background="{StaticResource KioskOnDarkSurfaceBrush}"
                                BorderBrush="{StaticResource KioskOnDarkLineBrush}" BorderThickness="1.5"
                                CornerRadius="18" Padding="20,0" MinHeight="72" SnapsToDevicePixels="True">
                            <DockPanel>
                                <Path x:Name="tick" DockPanel.Dock="Right" Data="{StaticResource IconCheck}"
                                      Fill="{StaticResource KioskForestBrush}" Stretch="Uniform" Width="22" Height="22"
                                      Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource KioskCreamBrush}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource KioskCreamBrush}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource KioskForestBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AdminChoiceList" TargetType="ListBox">
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource AdminChoiceItem}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interrupteur (démarrage de Windows) : texte à gauche, interrupteur à droite -->
        <Style x:Key="AdminToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource KioskOnDarkBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="{StaticResource KioskOnDarkSurfaceBrush}" BorderBrush="{StaticResource KioskOnDarkLineBrush}"
                                BorderThickness="1.5" CornerRadius="18" Padding="22,0" MinHeight="80">
                            <DockPanel>
                                <Border x:Name="track" DockPanel.Dock="Right" Width="80" Height="44" CornerRadius="22"
                                        Margin="16,0,0,0" VerticalAlignment="Center"
                                        Background="Transparent" BorderBrush="{StaticResource KioskOnDarkMutedBrush}" BorderThickness="2">
                                    <Ellipse x:Name="thumb" Width="30" Height="30" Margin="5,0" HorizontalAlignment="Left"
                                             Fill="{StaticResource KioskOnDarkMutedBrush}"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource KioskMintBrush}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource KioskMintBrush}"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Fill" Value="{StaticResource KioskDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Fond sombre fixe de la borne : réservé à l'équipe, distinct des écrans invités -->
    <Grid Background="{StaticResource KioskDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="96"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ En-tête ══ -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="{StaticResource KioskOnDarkLineBrush}" BorderThickness="0,0,0,1"
                Padding="32,0">
            <DockPanel>
                <!-- « Retour » : accueil de l'événement actif, sinon saisie du code (LAB-389) -->
                <Button DockPanel.Dock="Right" Command="{Binding BackCommand}" Style="{StaticResource KioskBackButton}"
                        Height="64" FontSize="19" Padding="22,0,28,0" BorderThickness="0"
                        Background="{StaticResource KioskCreamBrush}" Foreground="{StaticResource KioskForestBrush}"
                        Content="Retour à l'accueil"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding AppVersion}" FontSize="15" Margin="0,0,24,0"
                           VerticalAlignment="Center" Foreground="{StaticResource KioskOnDarkMutedBrush}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo du logiciel (Polabooth), version pour fond sombre -->
                    <Image Source="pack://application:,,,/Assets/Brand/polabooth-logo-horizontal-blanc.png"
                           Height="36" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border Width="1" Height="32" Margin="20,0" Background="{StaticResource KioskOnDarkLineBrush}"/>
                    <TextBlock Text="Administration" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource KioskOnDarkBrush}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ Menu de gauche ══ -->
        <Border Grid.Row="1" Grid.Column="0" BorderBrush="{StaticResource KioskOnDarkLineBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer Style="{StaticResource AdminScroll}">
                <StackPanel Margin="20,24">
                    <Button Style="{StaticResource AdminNavButton}" Tag="{Binding IsEventSection}"
                            Command="{Binding ShowSectionCommand}" CommandParameter="event">
                        <StackPanel>
                            <TextBlock Text="Événement" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ActiveEventName}" FontSize="15" Opacity="0.72" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AdminNavButton}" Tag="{Binding IsPrinterSection}"
                            Command="{Binding ShowSectionCommand}" CommandParameter="printer">
                        <StackPanel>
                            <TextBlock Text="Imprimante" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedPrinter}" FontSize="15" Opacity="0.72" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AdminNavButton}" Tag="{Binding IsCameraSection}"
                            Command="{Binding ShowSectionCommand}" CommandParameter="camera">
                        <StackPanel>
                            <TextBlock Text="Caméra" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedCamera.Label}" FontSize="15" Opacity="0.72" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AdminNavButton}" Tag="{Binding IsKioskSection}"
                            Command="{Binding ShowSectionCommand}" CommandParameter="kiosk">
                        <StackPanel>
                            <TextBlock Text="Borne" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="Nettoyage, démarrage, sortie" FontSize="15" Opacity="0.72" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ Section Événement ══ -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Style="{StaticResource AdminScroll}"
                      Visibility="{Binding IsEventSection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="40,32,40,40">
                <TextBlock Text="Événement" Style="{StaticResource AdminSectionTitle}"/>
                <TextBlock Text="L'événement chargé sur la borne, et le mode hors ligne." Style="{StaticResource AdminSectionSubtitle}"/>

                <Border Style="{StaticResource AdminCard}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" VerticalAlignment="Center" Margin="24,0,0,0"
                                Command="{Binding ChangeEventCommand}" Style="{StaticResource AdminPrimaryButton}"
                                Content="Changer d'événement"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Événement actif" Style="{StaticResource AdminHint}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ActiveEventName}" FontSize="30" FontWeight="SemiBold"
                                       FontFamily="{StaticResource KioskTitleFont}" TextWrapping="Wrap"
                                       Foreground="{StaticResource KioskOnDarkBrush}"/>
                            <TextBlock Text="{Binding ActiveEventId, StringFormat='ID : {0}'}" Style="{StaticResource AdminHint}"
                                       FontSize="13" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Import .pola (mode hors ligne) -->
                    <Border Grid.Column="0" Style="{StaticResource AdminCard}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Mode hors ligne" Style="{StaticResource AdminCardTitle}"/>
                            <TextBlock Style="{StaticResource AdminHint}" Margin="0,0,0,18">
                                Sans connexion internet, importez un fichier <Run FontWeight="Bold">.pola</Run>
                                exporté depuis l'espace admin du SaaS. Le client pourra ensuite entrer son code événement.
                            </TextBlock>
                            <Button Command="{Binding ImportPolaFileCommand}" HorizontalAlignment="Left"
                                    IsEnabled="{Binding IsImporting, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                    Style="{StaticResource AdminButton}">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Importer un fichier .pola"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsImporting}" Value="True">
                                                    <Setter Property="Text" Value="Import en cours..."/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                            <TextBlock Text="{Binding PolaStatusMsg}" Style="{StaticResource AdminStatus}"/>
                        </StackPanel>
                    </Border>

                    <!-- .pola déjà importés (LAB-321) : recharger un événement sans le fichier d'origine -->
                    <Border Grid.Column="2" Style="{StaticResource AdminCard}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Fichiers déjà importés" Style="{StaticResource AdminCardTitle}"/>
                            <TextBlock Style="{StaticResource AdminHint}" Margin="0,0,0,16"
                                       Text="Les 20 derniers fichiers restent sur la borne. « Recharger » refait l'import : l'événement redevient l'événement actif, sans réseau ni clé USB."/>
                            <TextBlock Text="Aucun fichier importé pour l'instant." Style="{StaticResource AdminHint}" FontStyle="Italic"
                                       Visibility="{Binding HasPolaHistory, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                            <ItemsControl ItemsSource="{Binding PolaHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource KioskDarkBrush}" BorderBrush="{StaticResource KioskOnDarkLineBrush}"
                                                BorderThickness="1" CornerRadius="16" Padding="18,14" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding EventName}" FontSize="18" FontWeight="SemiBold"
                                                               Foreground="{StaticResource KioskOnDarkBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding EventDates}" FontSize="15" Margin="0,4,0,0"
                                                               Foreground="{StaticResource KioskOnDarkBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding ImportedText}" Style="{StaticResource AdminHint}" FontSize="14" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Style="{StaticResource AdminOutlineButton}" VerticalAlignment="Center"
                                                        Padding="20,10"
                                                        Command="{Binding DataContext.ReloadPolaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Recharger"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ══ Section Imprimante ══ -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Style="{StaticResource AdminScroll}"
                      Visibility="{Binding IsPrinterSection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="40,32,40,40">
                <TextBlock Text="Imprimante" Style="{StaticResource AdminSectionTitle}"/>
                <TextBlock Text="Chaque choix est enregistré dès que vous le touchez." Style="{StaticResource AdminSectionSubtitle}"/>

                <Border Style="{StaticResource AdminCard}">
                    <StackPanel>
                        <TextBlock Text="Imprimante utilisée" Style="{StaticResource AdminCardTitle}"/>
                        <TextBlock Text="{Binding DefaultPrinterHint}" Style="{StaticResource AdminHint}" Margin="0,0,0,16"/>
                        <ListBox Style="{StaticResource AdminChoiceList}" ItemsSource="{Binding AvailablePrinters}"
                                 SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding PrinterStatusMsg}" Style="{StaticResource AdminStatus}" Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Bandes 5x15 (LAB-334) : réglages du pilote enregistrés une fois depuis sa fenêtre -->
                <Border Style="{StaticResource AdminCard}">
                    <StackPanel>
                        <TextBlock Text="Bandes 5x15" Style="{StaticResource AdminCardTitle}"/>
                        <TextBlock Style="{StaticResource AdminHint}" Margin="0,0,0,16"
                                   Text="Une bande s'imprime deux fois sur une feuille 10x15, que l'imprimante coupe en deux. Enregistrez une fois chaque réglage du pilote de l'imprimante choisie ci-dessus."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource AdminActionTile}" Command="{Binding RecordStripCutSettingCommand}">
                                <StackPanel>
                                    <TextBlock Text="Réglage bandes coupées" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource AdminHint}" Margin="0,6,0,0"
                                               Text="Dans la fenêtre qui s'ouvre, cochez la coupe 2 pouces (2inch cut) puis validez."/>
                                    <TextBlock Text="{Binding StripCutSettingStatus}" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource AdminActionTile}" Command="{Binding RecordNormalSettingCommand}">
                                <StackPanel>
                                    <TextBlock Text="Réglage normal (facultatif)" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Style="{StaticResource AdminHint}" Margin="0,6,0,0"
                                               Text="Vérifiez que la coupe 2 pouces (2inch cut) est décochée puis validez. Sans ce réglage, les 10x15 utilisent le réglage par défaut du pilote."/>
                                    <TextBlock Text="{Binding NormalSettingStatus}" FontSize="15" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding DriverSettingMsg}" Style="{StaticResource AdminStatus}"/>
                    </StackPanel>
                </Border>

                <!-- Décalage de l'impression (LAB-433) : un seul réglage par borne, dans le sens d'une photo en portrait -->
                <Border Style="{StaticResource AdminCard}">
                    <StackPanel>
                        <TextBlock Text="Décalage de l'impression" Style="{StaticResource AdminCardTitle}"/>
                        <TextBlock Style="{StaticResource AdminHint}" Margin="0,0,0,20"
                                   Text="D'un rouleau de papier à l'autre, l'image peut tomber un peu à côté. Imprimez la feuille de test, tenez-la avec « HAUT » en haut, puis décalez par pas de 0,5 mm. Le réglage vaut pour tous les cadres (10x15, paysage, bandes) et reste sur cette borne."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Pavé : une flèche par sens -->
                            <Grid Grid.Column="0" VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="96"/>
                                    <RowDefinition Height="96"/>
                                    <RowDefinition Height="96"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Row="0" Grid.Column="1" Command="{Binding MoveUpCommand}"
                                        Style="{StaticResource AdminPadButton}" Content="↑"/>
                                <Button Grid.Row="1" Grid.Column="0" Command="{Binding MoveLeftCommand}"
                                        Style="{StaticResource AdminPadButton}" Content="←"/>
                                <Border Grid.Row="1" Grid.Column="1" Width="64" Height="64" CornerRadius="14"
                                        BorderBrush="{StaticResource KioskOnDarkLineBrush}" BorderThickness="2">
                                    <TextBlock Text="HAUT" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Margin="0,8,0,0" Foreground="{StaticResource KioskOnDarkMutedBrush}"/>
                                </Border>
                                <Button Grid.Row="1" Grid.Column="2" Command="{Binding MoveRightCommand}"
                                        Style="{StaticResource AdminPadButton}" Content="→"/>
                                <Button Grid.Row="2" Grid.Column="1" Command="{Binding MoveDownCommand}"
                                        Style="{StaticResource AdminPadButton}" Content="↓"/>
                            </Grid>

                            <!-- Valeurs et agrandissement -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                <TextBlock Text="Gauche / droite" Style="{StaticResource AdminHint}"/>
                                <TextBlock Text="{Binding OffsetXLabel}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,16"
                                           Foreground="{StaticResource KioskOnDarkBrush}"/>
                                <TextBlock Text="Haut / bas" Style="{StaticResource AdminHint}"/>
                                <TextBlock Text="{Binding OffsetYLabel}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,16"
                                           Foreground="{StaticResource KioskOnDarkBrush}"/>
                                <TextBlock Text="Agrandissement" Style="{StaticResource AdminHint}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding EnlargeLessCommand}" Style="{StaticResource AdminPadButton}"
                                            Width="72" Height="72" Content="−"/>
                                    <TextBlock Text="{Binding EnlargeLabel}" MinWidth="110" TextAlignment="Center" VerticalAlignment="Center"
                                               FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource KioskOnDarkBrush}"/>
                                    <Button Command="{Binding EnlargeMoreCommand}" Style="{StaticResource AdminPadButton}"
                                            Width="72" Height="72" Content="+"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource AdminHint}" Margin="0,20,0,16"
                                   Text="Un bord blanc apparaît après un décalage ? Agrandissez un peu : l'image couvre de nouveau toute la feuille."/>
                        <WrapPanel>
                            <Button Command="{Binding PrintTestSheetCommand}" Style="{StaticResource AdminPrimaryButton}"
                                    Margin="0,0,12,0" Content="Imprimer une feuille de test"/>
                            <Button Command="{Binding ResetPrintAdjustmentCommand}" Style="{StaticResource AdminOutlineButton}"
                                    Content="Remettre à zéro"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding PrintAdjustMsg}" Style="{StaticResource AdminStatus}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ══ Section Caméra ══ -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Style="{StaticResource AdminScroll}"
                      Visibility="{Binding IsCameraSection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="40,32,40,40">
                <TextBlock Text="Caméra" Style="{StaticResource AdminSectionTitle}"/>
                <TextBlock Text="Testez l'appareil, choisissez la source et la taille des photos." Style="{StaticResource AdminSectionSubtitle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tester la caméra (LAB-263) : appareil choisi au démarrage -->
                    <Border Grid.Column="0" Style="{StaticResource AdminCard}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Aperçu et photo de test" Style="{StaticResource AdminCardTitle}"/>
                            <TextBlock Text="Appareil utilisé par la borne : aperçu en direct, puis photo de test pour vérifier la définition."
                                       Style="{StaticResource AdminHint}" Margin="0,0,0,16"/>
                            <Border CornerRadius="16" ClipToBounds="True" Height="260" Margin="0,0,0,16"
                                    Background="{StaticResource KioskDarkBrush}"
                                    BorderBrush="{StaticResource KioskOnDarkLineBrush}" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="Aperçu arrêté" Style="{StaticResource AdminHint}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasTestPreview, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                    <Image Source="{Binding TestPreview}" Stretch="Uniform"
                                           Visibility="{Binding HasTestPreview, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding TestCameraCommand}" Style="{StaticResource AdminButton}"
                                        Padding="12" Content="Tester la caméra"
                                        Visibility="{Binding HasTestPreview, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                <Button Grid.Column="0" Command="{Binding StopCameraTestCommand}" Style="{StaticResource AdminOutlineButton}"
                                        Padding="12" Content="Arrêter l'aperçu"
                                        Visibility="{Binding HasTestPreview, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Grid.Column="2" Command="{Binding CaptureTestPhotoCommand}" Style="{StaticResource AdminButton}"
                                        Padding="12" Content="Photo de test"/>
                            </Grid>
                            <TextBlock Text="{Binding CameraTestMsg}" Style="{StaticResource AdminStatus}"/>
                            <TextBlock Text="{Binding LowDefinitionWarning}" Style="{StaticResource AdminStatus}"
                                       Foreground="{StaticResource KioskErrorOnDarkBrush}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource AdminCard}">
                            <StackPanel>
                                <TextBlock Text="Caméra utilisée" Style="{StaticResource AdminCardTitle}"/>
                                <TextBlock Text="« Détection automatique » privilégie le Canon, sinon une webcam. Choisissez une source précise si besoin."
                                           Style="{StaticResource AdminHint}" Margin="0,0,0,16"/>
                                <ListBox Style="{StaticResource AdminChoiceList}" ItemsSource="{Binding AvailableCameras}"
                                         DisplayMemberPath="Label" SelectedItem="{Binding SelectedCamera, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding CameraStatusMsg}" Style="{StaticResource AdminStatus}" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Réglages d'exposition du Canon (LAB-427) -->
                        <Border Style="{StaticResource AdminCard}">
                            <StackPanel>
                                <TextBlock Text="Réglages de l'appareil photo" Style="{StaticResource AdminCardTitle}"/>
                                <TextBlock Text="Vitesse, ouverture, ISO et balance des blancs du Canon, gardés sur cette borne."
                                           Style="{StaticResource AdminHint}" Margin="0,0,0,16"/>
                                <Button Command="{Binding OpenExposureCommand}" Style="{StaticResource AdminPrimaryButton}"
                                        HorizontalAlignment="Left" Content="Ouvrir les réglages"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource AdminCard}">
                    <StackPanel>
                        <TextBlock Text="Taille des photos du Canon" Style="{StaticResource AdminCardTitle}"/>
                        <TextBlock Text="« Moyenne » suffit largement pour l'impression 10 × 15 et allège le PC ; le montage imprimé et envoyé ne change pas."
                                   Style="{StaticResource AdminHint}" Margin="0,0,0,16"/>
                        <ListBox Style="{StaticResource AdminChoiceList}" ItemsSource="{Binding PhotoSizes}"
                                 DisplayMemberPath="Label" SelectedItem="{Binding SelectedPhotoSize, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding PhotoSizeStatusMsg}" Style="{StaticResource AdminStatus}" Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ══ Section Borne ══ -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" Style="{StaticResource AdminScroll}"
                      Visibility="{Binding IsKioskSection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="40,32,40,40">
                <TextBlock Text="Borne" Style="{StaticResource AdminSectionTitle}"/>
                <TextBlock Text="Réglages du PC de la borne." Style="{StaticResource AdminSectionSubtitle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nettoyage du PC -->
                    <Border Grid.Column="0" Style="{StaticResource AdminCard}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Nettoyage du PC" Style="{StaticResource AdminCardTitle}"/>
                            <TextBlock Text="Les photos d'un événement terminé sont supprimées du PC après ce délai, seulement si elles ont toutes été envoyées en ligne. L'événement en cours n'est jamais supprimé."
                                       Style="{StaticResource AdminHint}" Margin="0,0,0,16"/>
                            <ListBox Style="{StaticResource AdminChoiceList}" ItemsSource="{Binding RetentionOptions}"
                                     DisplayMemberPath="Label" SelectedItem="{Binding SelectedRetention, Mode=TwoWay}"/>
                            <TextBlock Text="{Binding RetentionStatusMsg}" Style="{StaticResource AdminStatus}" Margin="0,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Démarrage de Windows : raccourci du watchdog dans le dossier Démarrage (désactivé par défaut) -->
                    <Border Grid.Column="2" Style="{StaticResource AdminCard}" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Démarrage de Windows" Style="{StaticResource AdminCardTitle}"/>
                            <TextBlock Text="Activé, la borne s'ouvre toute seule à chaque démarrage du PC. Désactivé, on l'ouvre à la main (icône PolaKiosk du Bureau). Dans les deux cas, elle se relance toute seule après un plantage ou une mise à jour."
                                       Style="{StaticResource AdminHint}" Margin="0,0,0,16"/>
                            <CheckBox Style="{StaticResource AdminToggle}"
                                      IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"
                                      IsEnabled="{Binding CanChangeLaunchAtStartup}">
                                <TextBlock Text="Lancer la borne au démarrage de Windows" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Text="{Binding LaunchAtStartupStatusMsg}" Style="{StaticResource AdminStatus}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Zone sensible : chaque action demande une confirmation -->
                <Border Style="{StaticResource AdminCard}" BorderBrush="{StaticResource KioskErrorOnDarkBrush}" BorderThickness="2">
                    <StackPanel>
                        <TextBlock Text="Zone sensible" Style="{StaticResource AdminCardTitle}"
                                   Foreground="{StaticResource KioskErrorOnDarkBrush}"/>
                        <TextBlock Text="Chaque action demande une confirmation." Style="{StaticResource AdminHint}" Margin="0,0,0,8"/>

                        <!-- Adresse du SaaS (open core K2) : seulement pour une adresse saisie sur la borne -->
                        <Border BorderBrush="{StaticResource KioskOnDarkLineBrush}" BorderThickness="0,0,0,1" Padding="0,16"
                                Visibility="{Binding CanChangeSaas, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Command="{Binding AskSaasChangeCommand}" Style="{StaticResource AdminOutlineButton}"
                                            VerticalAlignment="Center" Margin="20,0,0,0" Content="Changer de SaaS"
                                            Visibility="{Binding IsConfirmingSaasChange, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                    <StackPanel>
                                        <TextBlock Text="Adresse du SaaS" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource KioskOnDarkBrush}"/>
                                        <TextBlock Text="{Binding SaasAddressText}" FontSize="16" Margin="0,4,0,6" TextWrapping="Wrap"
                                                   Foreground="{StaticResource KioskOnDarkBrush}"/>
                                        <TextBlock Text="Changer de SaaS efface aussi l'association de la borne, son PIN admin et l'événement chargé. La borne redémarre sur la saisie de l'adresse, puis l'association."
                                                   Style="{StaticResource AdminHint}"/>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel Margin="0,14,0,0" Visibility="{Binding IsConfirmingSaasChange, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="Confirmer ? La borne devra être associée de nouveau."
                                               FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource KioskOnDarkBrush}" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button Command="{Binding ConfirmSaasChangeCommand}" Style="{StaticResource AdminDangerButton}"
                                                Margin="0,0,12,0" Content="Oui, changer de SaaS"/>
                                        <Button Command="{Binding CancelSaasChangeCommand}" Style="{StaticResource AdminOutlineButton}"
                                                Content="Annuler"/>
                                    </WrapPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding SaasStatusMsg}" Style="{StaticResource AdminStatus}"/>
                            </StackPanel>
                        </Border>

                        <!-- Quitter vers Windows : sans relance par le watchdog -->
                        <StackPanel Margin="0,16,0,0">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding AskQuitCommand}" Style="{StaticResource AdminOutlineButton}"
                                        VerticalAlignment="Center" Margin="20,0,0,0" Content="Quitter vers Windows"
                                        Visibility="{Binding IsConfirmingQuit, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                <StackPanel>
                                    <TextBlock Text="Quitter vers Windows" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource KioskOnDarkBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Ferme la borne sans qu'elle se relance toute seule. Elle repart en lançant PolaKiosk à la main, ou au prochain démarrage de Windows si le lancement au démarrage est activé."
                                               Style="{StaticResource AdminHint}"/>
                                </StackPanel>
                            </DockPanel>
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding IsConfirmingQuit, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="Confirmer ? Les invités ne pourront plus utiliser la borne."
                                           FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource KioskOnDarkBrush}" Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button Command="{Binding ConfirmQuitCommand}" Style="{StaticResource AdminDangerButton}"
                                            Margin="0,0,12,0" Content="Oui, quitter"/>
                                    <Button Command="{Binding CancelQuitCommand}" Style="{StaticResource AdminOutlineButton}"
                                            Content="Annuler"/>
                                </WrapPanel>
                            </StackPanel>
                            <TextBlock Text="{Binding QuitStatusMsg}" Style="{StaticResource AdminStatus}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Appareil photo (LAB-427) : vitesse, ouverture, ISO, balance des blancs du Canon, par-dessus
             l'Admin. Aperçu à gauche, réglages à droite (gros boutons − / + pour l'écran tactile). -->
        <Grid Background="{StaticResource KioskDarkBrush}"
              Visibility="{Binding IsExposureOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid Margin="32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Titre -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <Button DockPanel.Dock="Right" Command="{Binding CloseExposureCommand}"
                            Style="{StaticResource AdminButton}" MinHeight="64" MinWidth="140" Content="Fermer"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Appareil photo" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{StaticResource KioskOnDarkBrush}"/>
                        <TextBlock Style="{StaticResource AdminHint}"
                                   Visibility="{Binding IsExposureSupported, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="{Binding ExposureModel, Mode=OneWay}"/><Run Text=" · mode "/><Run Text="{Binding ExposureMode, Mode=OneWay}"/><Run Text=" · réglages gardés sur cette borne"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- Bandeau : molette pas sur M -->
                <Border Grid.Row="1" Background="{StaticResource KioskCreamBrush}" CornerRadius="8"
                        Padding="20,14" Margin="0,0,0,12"
                        Visibility="{Binding NeedsManualMode, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource KioskWarningBrush}">
                        <Run Text="Mettez la molette de l'appareil sur M pour modifier les réglages (mode actuel : "/><Run Text="{Binding ExposureMode, Mode=OneWay}"/><Run Text=")."/>
                    </TextBlock>
                </Border>

                <!-- Aperçu (ou photo de test) et réglages -->
                <Grid Grid.Row="2" Visibility="{Binding IsExposureSupported, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border CornerRadius="8" ClipToBounds="True" Background="{StaticResource KioskOnDarkSurfaceBrush}">
                            <Grid>
                                <Image Source="{Binding TestPreview}" Stretch="Uniform"
                                       Visibility="{Binding HasExposureTestPhoto, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                <Image Source="{Binding ExposureTestPhoto}" Stretch="Uniform"
                                       Visibility="{Binding HasExposureTestPhoto, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource AdminHint}" Margin="0,0,0,10"
                                       Text="L'aperçu n'est pas éclairé comme la photo (flash) : prenez une photo de test pour juger le rendu. Elle n'est ni gardée ni envoyée."/>
                            <WrapPanel>
                                <Button Command="{Binding TakeExposureTestPhotoCommand}" Style="{StaticResource AdminButton}"
                                        MinHeight="80" Margin="0,0,12,0" Content="Prendre une photo de test"
                                        Visibility="{Binding HasExposureTestPhoto, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                <Button Command="{Binding BackToExposurePreviewCommand}" Style="{StaticResource AdminButton}"
                                        MinHeight="80" Margin="0,0,12,0" Content="Revenir à l'aperçu"
                                        Visibility="{Binding HasExposureTestPhoto, Converter={StaticResource BoolToVisibility}}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding ExposureSettings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AdminCard}" Padding="20,14" Margin="0,0,0,12"
                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ValueLabel}" FontSize="24"
                                                           FontWeight="SemiBold" Foreground="{StaticResource KioskOnDarkBrush}"/>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource AdminCardTitle}"
                                                           VerticalAlignment="Center" Margin="0"/>
                                            </DockPanel>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Command="{Binding DecrementCommand}"
                                                        IsEnabled="{Binding CanDecrement}"
                                                        Style="{StaticResource AdminButton}" Width="80" Height="80"
                                                        Padding="0" FontSize="32" Content="−"/>
                                                <Slider Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                                                        Minimum="0" Maximum="{Binding MaxIndex}" TickFrequency="1"
                                                        IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                                        IsEnabled="{Binding IsEnabled}"
                                                        Value="{Binding SelectedIndex, Mode=TwoWay}"/>
                                                <Button Grid.Column="2" Command="{Binding IncrementCommand}"
                                                        IsEnabled="{Binding CanIncrement}"
                                                        Style="{StaticResource AdminButton}" Width="80" Height="80"
                                                        Padding="0" FontSize="32" Content="+"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Warning}" Margin="0,8,0,0" FontSize="15"
                                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{StaticResource KioskErrorOnDarkBrush}"
                                                       Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Message (refus de l'appareil, autre caméra, photo de test) -->
                <TextBlock Grid.Row="3" Text="{Binding ExposureMsg}" Margin="0,12,0,0" FontSize="17"
                           FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource KioskOnDarkBrush}"
                           Visibility="{Binding HasExposureMsg, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
