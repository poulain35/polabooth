<UserControl x:Class="PolaKiosk.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PolaKiosk.ViewModels"
             xmlns:local="clr-namespace:PolaKiosk.Views"
             SizeChanged="OnSizeChanged">
    <!-- Accueil (LAB-251, maquettes 1a, 1b, 1c en 1280×800) : texte à gauche, tirage de l'événement
         à droite. 1a et 1b démarrent sur tout l'écran, 1c seulement sur les tuiles de format. -->
    <UserControl.Resources>
        <local:LetterSpacingConverter x:Key="LetterSpacing"/>

        <!-- Icônes au trait (grille 24×24) -->
        <Geometry x:Key="HomeCameraIcon">M4 8h3l2-3h6l2 3h3v11H4z M8.5 13a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0 -7 0z</Geometry>
        <Geometry x:Key="HomeVideoIcon">M5 6h8a2.5 2.5 0 0 1 2.5 2.5v7a2.5 2.5 0 0 1 -2.5 2.5h-8a2.5 2.5 0 0 1 -2.5 -2.5v-7a2.5 2.5 0 0 1 2.5 -2.5z M15.5 10.5l6 -3.5v10l-6 -3.5z</Geometry>
        <Geometry x:Key="HomeGifIcon">M6 5h12a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3z M10 9.5v5l4.5 -2.5z</Geometry>
        <Geometry x:Key="HomeBoomerangIcon">M17 2l4 4 -4 4 M3 11v-1a4 4 0 0 1 4 -4h14 M7 22l-4 -4 4 -4 M21 13v1a4 4 0 0 1 -4 4H3</Geometry>
        <Geometry x:Key="HomeLockIcon">M12 1a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2h-1V6a5 5 0 0 0-5-5zm3 8H9V6a3 3 0 0 1 6 0v3z</Geometry>

        <!-- Icône au trait : la couleur vient de Stroke, la taille de Width/Height -->
        <Style x:Key="HomeStrokeIcon" TargetType="Path">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.8"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stroke" Value="{StaticResource KioskForestBrush}"/>
        </Style>

        <!-- Ombre du tirage posé sur l'arche (0 24px 48px, vert forêt 22 %) -->
        <DropShadowEffect x:Key="HomePrintShadow" Color="{StaticResource KioskForestColor}"
                          Opacity="0.22" BlurRadius="48" ShadowDepth="24" Direction="270"/>

        <!-- Surtitre en capitales (« PHOTOBOOTH », « BIENVENUE AU PHOTOBOOTH DE ») -->
        <Style x:Key="HomeOverline" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource KioskTextFont}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource KioskBrownBrush}"/>
        </Style>

        <!-- Grand titre Fraunces : taille ajustée au texte par HomeView.FitTitle -->
        <Style x:Key="HomeDisplay" TargetType="TextBlock" BasedOn="{StaticResource KioskTitleText}">
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Pulsation : le rond grandit en s'effaçant, en boucle -->
        <Storyboard x:Key="HomeButtonPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="1.7" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="1.7" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="0" Duration="0:0:1.8">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="HomeDotPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="2.6" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="2.6" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.6" To="0" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Halo qui pulse derrière un rond (bouton de 1a, point de 1b et 1c) -->
        <Style x:Key="HomePulseHalo" TargetType="Ellipse">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="RenderTransform">
                <Setter.Value><ScaleTransform/></Setter.Value>
            </Setter>
        </Style>

        <!-- Étiquette « Liste des photos prises » posée sur le tirage (un appui ouvre la galerie) -->
        <Style x:Key="HomePhotoLabel" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{StaticResource KioskPaperColor}" Opacity="0.88"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tuile de format (1c) : la première en vert forêt, les autres sur papier -->
        <Style x:Key="HomeFormatTile" TargetType="Button">
            <Setter Property="Width" Value="184"/>
            <Setter Property="Height" Value="156"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="{StaticResource KioskPaperBrush}"/>
            <Setter Property="BorderBrush" Value="#D9CDB8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource KioskForestBrush}"/>
            <Setter Property="Tag" Value="{StaticResource KioskBrownBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="28" Padding="22" SnapsToDevicePixels="True">
                            <DockPanel>
                                <Path x:Name="icon" DockPanel.Dock="Top" HorizontalAlignment="Left"
                                      Width="34" Height="34" Style="{StaticResource HomeStrokeIcon}"
                                      Stroke="{TemplateBinding Foreground}" Data="{StaticResource HomeCameraIcon}"/>
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Subtitle}" FontSize="15"
                                           Foreground="{TemplateBinding Tag}" TextWrapping="Wrap" LineHeight="19"
                                           LineStackingStrategy="BlockLineHeight" MaxHeight="38"/>
                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource KioskTitleFont}"
                                           FontWeight="SemiBold" FontSize="28" Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Format}" Value="{x:Static vm:CaptureFormat.Video}">
                                <Setter TargetName="icon" Property="Data" Value="{StaticResource HomeVideoIcon}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Format}" Value="{x:Static vm:CaptureFormat.Gif}">
                                <Setter TargetName="icon" Property="Data" Value="{StaticResource HomeGifIcon}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Format}" Value="{x:Static vm:CaptureFormat.Boomerang}">
                                <Setter TargetName="icon" Property="Data" Value="{StaticResource HomeBoomerangIcon}"/>
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                    <Setter Property="Background" Value="{StaticResource KioskForestBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource KioskForestBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource KioskCreamBrush}"/>
                    <Setter Property="Tag" Value="{StaticResource KioskMintBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid MouseDown="OnScreenTapped" Background="{StaticResource KioskCreamBrush}">

        <!-- Fond de l'événement en plein écran, à la place du crème -->
        <Image Source="{Binding BackgroundImage}" Stretch="UniformToFill"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVisibility}}"/>

        <!-- Voile crème sur l'image, plus dense côté texte : le texte reste lisible -->
        <Border Background="{StaticResource KioskCreamBrush}" IsHitTestVisible="False"
                Visibility="{Binding HasBackgroundImage, Converter={StaticResource BoolToVisibility}}">
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0"    Color="#E6000000"/>
                    <GradientStop Offset="0.5"  Color="#CC000000"/>
                    <GradientStop Offset="1"    Color="#4D000000"/>
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>

        <!-- Surface de la maquette (800 de haut, largeur à la proportion de l'écran), mise à l'échelle -->
        <Viewbox Stretch="Uniform">
            <Grid x:Name="DesignSurface" Width="1280" Height="800" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Arche vert d'eau et rond rose poudré -->
                <Border Grid.RowSpan="2" Width="600" Height="720" CornerRadius="300,300,0,0"
                        Background="{StaticResource KioskMintBrush}" IsHitTestVisible="False"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-60,-40"/>
                <Ellipse Grid.RowSpan="2" Width="110" Height="110" Fill="{StaticResource KioskBlushBrush}"
                         IsHitTestVisible="False"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,80,470,0"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="720"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── Colonne de gauche : marque, textes, appel à l'action ── -->
                    <Grid Margin="80,64,0,64">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Marque (LAB-257) : logo de la société, sinon icône et nom de la société -->
                        <Image Source="{Binding LogoImage}" Stretch="Uniform"
                               MaxWidth="280" MaxHeight="48"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}"/>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <Path Width="30" Height="30" Style="{StaticResource HomeStrokeIcon}"
                                  Data="{StaticResource HomeCameraIcon}" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding BrandName}" FontFamily="{StaticResource KioskTitleFont}"
                                       FontWeight="SemiBold" FontSize="24" VerticalAlignment="Center"
                                       MaxWidth="560" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource KioskForestBrush}"/>
                        </StackPanel>

                        <!-- 1a : accueil neutre -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                    Visibility="{Binding IsNeutral, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding Source=PHOTOBOOTH, Converter={StaticResource LetterSpacing}}" Style="{StaticResource HomeOverline}" Margin="0,0,0,20"/>
                            <TextBlock x:Name="NeutralTitle" Style="{StaticResource HomeDisplay}"
                                       FontSize="96" LineHeight="94" Text="Touchez l'écran&#10;pour commencer"/>
                        </StackPanel>

                        <!-- 1b et 1c : nom et date de l'événement -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center"
                                    Visibility="{Binding IsNeutral, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <TextBlock Text="{Binding Source='BIENVENUE AU PHOTOBOOTH DE', Converter={StaticResource LetterSpacing}}" Style="{StaticResource HomeOverline}" Margin="0,0,0,18"/>
                            <TextBlock x:Name="NameTitle" Style="{StaticResource HomeDisplay}"
                                       FontSize="108" LineHeight="103" Text="{Binding DisplayName}"/>
                            <TextBlock Text="{Binding DateText}" FontSize="22" Foreground="{StaticResource KioskBrownBrush}"
                                       Margin="0,18,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasDate, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>

                        <!-- 1a : bouton rond qui pulse -->
                        <Grid Grid.Row="2" Width="96" Height="96" HorizontalAlignment="Left" IsHitTestVisible="False"
                              Visibility="{Binding IsNeutral, Converter={StaticResource BoolToVisibility}}">
                            <Ellipse Style="{StaticResource HomePulseHalo}" Fill="{StaticResource KioskForestBrush}">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard Storyboard="{StaticResource HomeButtonPulse}"/>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Fill="{StaticResource KioskForestBrush}"/>
                            <Path Width="42" Height="42" Style="{StaticResource HomeStrokeIcon}" StrokeThickness="1.7"
                                  Stroke="{StaticResource KioskCreamBrush}" Data="{StaticResource HomeCameraIcon}"/>
                        </Grid>

                        <!-- 1b : pastille « Touchez l'écran pour commencer » -->
                        <Border Grid.Row="2" Height="76" Padding="28,0,34,0" CornerRadius="38" HorizontalAlignment="Left"
                                Background="{StaticResource KioskForestBrush}" IsHitTestVisible="False"
                                Visibility="{Binding IsPersonalized, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="14" Height="14" Margin="0,0,16,0">
                                    <Ellipse Style="{StaticResource HomePulseHalo}" Fill="{StaticResource KioskBlushBrush}">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource HomeDotPulse}"/>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <Ellipse Fill="{StaticResource KioskBlushBrush}"/>
                                </Grid>
                                <TextBlock Text="Touchez l'écran pour commencer" FontSize="24" FontWeight="SemiBold"
                                           Foreground="{StaticResource KioskCreamBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 1c : une tuile par format, seules les tuiles démarrent -->
                        <StackPanel Grid.Row="2"
                                    Visibility="{Binding IsFormatChoice, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <Grid Width="14" Height="14" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Ellipse Style="{StaticResource HomePulseHalo}" Fill="{StaticResource KioskForestBrush}">
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource HomeDotPulse}"/>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <Ellipse Fill="{StaticResource KioskForestBrush}"/>
                                </Grid>
                                <TextBlock Text="Touchez un format pour commencer" FontSize="22" FontWeight="SemiBold"
                                           Foreground="{StaticResource KioskForestBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Tiles}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HomeFormatTile}">
                                        <Button Style="{StaticResource HomeFormatTile}" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.StartFormatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                    <!-- ── Colonne de droite : tirage de l'événement, incliné sur l'arche ── -->
                    <Grid Grid.Column="1" Margin="0,0,30,0">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5" Background="Transparent" MouseDown="OnPrintTapped">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="-4"/>
                            </Grid.RenderTransform>

                            <!-- Design approuvé : dernier montage, ou design troué sur du sauge avant la 1re photo -->
                            <Border Width="{Binding PrintWidth}" Height="{Binding PrintHeight}"
                                    Background="{StaticResource KioskPaperBrush}" CornerRadius="6"
                                    Effect="{StaticResource HomePrintShadow}"
                                    Visibility="{Binding HasDesign, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Border Background="{StaticResource KioskSageBrush}"
                                            Visibility="{Binding HasPhotos, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                    <Image Source="{Binding DesignImage}" Stretch="Uniform"
                                           Visibility="{Binding HasPhotos, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"/>
                                    <Image Source="{Binding LastPhoto}" Stretch="Uniform"
                                           Visibility="{Binding HasPhotos, Converter={StaticResource BoolToVisibility}}"/>
                                    <Border Style="{StaticResource HomePhotoLabel}" Margin="{Binding PhotoLabelMargin}"
                                            Visibility="{Binding HasPhotos, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14" Style="{StaticResource HomeStrokeIcon}" StrokeThickness="2"
                                                  Data="{StaticResource HomeCameraIcon}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Liste des photos prises" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource KioskForestBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Sans design : tirage de la maquette, photo puis nom et date -->
                            <Border Width="360" Height="530" Padding="18,18,18,0"
                                    Background="{StaticResource KioskPaperBrush}" CornerRadius="6"
                                    Effect="{StaticResource HomePrintShadow}"
                                    Visibility="{Binding HasDesign, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Height="400">
                                        <Border Background="{StaticResource KioskSageBrush}" CornerRadius="3"/>
                                        <Border ClipToBounds="True">
                                            <Image Source="{Binding LastPhoto}" Stretch="UniformToFill"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Style="{StaticResource HomePhotoLabel}" Margin="14"
                                                Visibility="{Binding HasPhotos, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="14" Height="14" Style="{StaticResource HomeStrokeIcon}" StrokeThickness="2"
                                                      Data="{StaticResource HomeCameraIcon}" Margin="0,0,8,0"/>
                                                <TextBlock Text="Liste des photos prises" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource KioskForestBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <!-- Nom long : réduit pour tenir dans la largeur du tirage, jamais coupé -->
                                        <Viewbox StretchDirection="DownOnly" MaxWidth="324" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding PrintFooterName}" FontFamily="{StaticResource KioskTitleFont}"
                                                   FontWeight="SemiBold" Foreground="{StaticResource KioskForestBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontSize" Value="26"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNeutral}" Value="True">
                                                            <Setter Property="FontSize" Value="24"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        </Viewbox>
                                        <TextBlock Text="{Binding ShortDate, Converter={StaticResource LetterSpacing}}" FontSize="12" Foreground="{StaticResource KioskBrownBrush}"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"
                                                   Visibility="{Binding HasShortDate, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Mention du questionnaire obligatoire (LAB-222) : bandeau du bas, lisible de loin.
                     IsHitTestVisible=False : un appui dessus agit comme le reste de l'écran. -->
                <Border Grid.Row="1" Background="{StaticResource KioskForestBrush}" Padding="32,18" IsHitTestVisible="False"
                        Visibility="{Binding ShowHomeNotice, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding HomeNotice}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskCreamBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>

                <!-- Problème technique (LAB-263) : appareil photo débranché. Couvre tout l'accueil (séance
                     impossible) ; placé avant le cadenas pour que l'accès admin reste possible. -->
                <Border Grid.RowSpan="2" Background="{StaticResource KioskCreamBrush}"
                        Visibility="{Binding IsCameraMissing, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource KioskTile}" Width="820" Padding="64,56"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <Grid Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,28">
                                <Ellipse Fill="{StaticResource KioskErrorBrush}"/>
                                <Path Width="44" Height="44" Style="{StaticResource HomeStrokeIcon}" StrokeThickness="1.7"
                                      Stroke="{StaticResource KioskCreamBrush}" Data="{StaticResource HomeCameraIcon}"/>
                            </Grid>
                            <TextBlock Text="Problème technique" Style="{StaticResource KioskTitleText}"
                                       FontSize="56" TextAlignment="Center" Margin="0,0,0,24"/>
                            <TextBlock Text="{Binding TechnicalProblemText}" Style="{StaticResource KioskBodyText}"
                                       FontSize="28" LineHeight="40" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Accès admin (coin haut droit), discret : sortir du mode kiosk via PIN -->
                <Button Command="{Binding PinPad.OpenAdminPinCommand}"
                        VerticalAlignment="Top" HorizontalAlignment="Right"
                        Margin="24" Width="56" Height="56" Opacity="0.7"
                        Focusable="False" IsTabStop="False"
                        Style="{StaticResource KioskIconButton}"
                        Visibility="{Binding PinPad.ShowPinEntry, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <Path Width="24" Height="24" Stretch="Uniform" Fill="{StaticResource KioskForestBrush}"
                          Data="{StaticResource HomeLockIcon}"/>
                </Button>
            </Grid>
        </Viewbox>

        <!-- Overlay saisie PIN avec pavé numérique -->
        <Border Background="{StaticResource KioskCreamBrush}" DataContext="{Binding PinPad}"
                Visibility="{Binding ShowPinEntry, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">

                <TextBlock Text="Code administrateur"
                           Style="{StaticResource KioskTitleText}" FontSize="30"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Entrez le code PIN"
                           FontSize="16" Foreground="{StaticResource KioskBrownBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <!-- Affichage des points (un ● par chiffre saisi) -->
                <TextBlock Text="{Binding PinDots}"
                           FontSize="32" Foreground="{StaticResource KioskForestBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"
                           MinHeight="40"/>

                <!-- Erreur -->
                <TextBlock Text="{Binding PinError}"
                           FontSize="15" FontWeight="Medium" Foreground="{StaticResource KioskErrorBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,0,0,16"
                           Visibility="{Binding HasPinError, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Pavé numérique 3×4 -->
                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <UniformGrid.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource KioskPadKey}"/>
                    </UniformGrid.Resources>

                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="1">
                        <TextBlock Text="1"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="2">
                        <TextBlock Text="2"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="3">
                        <TextBlock Text="3"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="4">
                        <TextBlock Text="4"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="5">
                        <TextBlock Text="5"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="6">
                        <TextBlock Text="6"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="7">
                        <TextBlock Text="7"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="8">
                        <TextBlock Text="8"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="9">
                        <TextBlock Text="9"/>
                    </Button>
                    <!-- Ligne basse : annuler / 0 / effacer -->
                    <Button Command="{Binding CloseAdminPinCommand}">
                        <TextBlock Text="✕" FontSize="22" Foreground="{StaticResource KioskBrownBrush}"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="0">
                        <TextBlock Text="0"/>
                    </Button>
                    <Button Command="{Binding DeleteDigitCommand}">
                        <TextBlock Text="⌫" FontSize="22"/>
                    </Button>
                </UniformGrid>

                <!-- Valider : le PIN fait 4 à 8 chiffres, sa longueur n'est pas connue d'avance -->
                <Button Command="{Binding ValidatePinCommand}" Height="72" Margin="6,0,6,0"
                        Style="{StaticResource KioskPrimaryButton}" Padding="0">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Valider"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                        <Setter Property="Text" Value="Vérification..."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
