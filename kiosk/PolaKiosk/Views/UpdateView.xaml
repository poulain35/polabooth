<UserControl x:Class="PolaKiosk.Views.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource KioskCreamBrush}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600" Margin="40">

            <!-- Anneau qui tourne : un quart vert forêt sur un cercle sauge -->
            <Grid Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,28"
                  RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate"/>
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                 Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:0.9"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Border CornerRadius="32" BorderBrush="{StaticResource KioskSageBrush}" BorderThickness="5" Opacity="0.45"/>
                <Border CornerRadius="32" BorderBrush="{StaticResource KioskForestBrush}" BorderThickness="5,5,0,0"/>
            </Grid>

            <TextBlock Text="Mise à jour en cours…" Style="{StaticResource KioskTitleText}" FontSize="32"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="L'application va redémarrer automatiquement. Merci de patienter."
                       Style="{StaticResource KioskBodyText}" FontSize="18"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
