<UserControl x:Class="PolaKiosk.Views.EventSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource KioskCreamBrush}">

        <!-- Image de fond pré-chargée pendant le splash (KioskSetupBgImage = null si absent).
             Voile crème par-dessus : les textes restent vert forêt, lisibles sur toute image. -->
        <Image Source="{DynamicResource KioskSetupBgImage}" Stretch="UniformToFill"/>
        <Border Background="{StaticResource KioskCreamVeilBrush}"/>

        <!-- ① Écran principal -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">

            <!-- Marque (LAB-261) : logo de la société, sinon son nom et « Photobooth » -->
            <Image Source="{Binding LogoImage}" Stretch="Uniform"
                   MaxWidth="400" MaxHeight="110"
                   HorizontalAlignment="Center" Margin="0,0,0,48"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}}"/>
            <StackPanel Visibility="{Binding HasLogo, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                <TextBlock Text="{Binding ContactCompany}"
                           Style="{StaticResource KioskTitleText}" FontSize="38"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Photobooth"
                           FontSize="18" Foreground="{StaticResource KioskBrownBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,48"/>
            </StackPanel>

            <Border Style="{StaticResource KioskTile}" Padding="40,36">
                <StackPanel>

                    <TextBlock Text="Entrez votre code événement"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource KioskForestBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Ce code vous a été envoyé par email"
                               FontSize="16" Foreground="{StaticResource KioskBrownBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,28"/>

                    <!-- Champ code -->
                    <Border Background="{StaticResource KioskCreamBrush}" CornerRadius="20"
                            BorderBrush="{StaticResource KioskSageBrush}" BorderThickness="2"
                            Margin="0,0,0,16">
                        <TextBox x:Name="CodeInput"
                                 Text="{Binding AccessCode, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="32" FontWeight="Bold"
                                 Foreground="{StaticResource KioskForestBrush}"
                                 CaretBrush="{StaticResource KioskForestBrush}"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="16,12" MaxLength="6"
                                 CharacterCasing="Upper"
                                 HorizontalContentAlignment="Center"
                                 KeyDown="OnCodeKeyDown">
                            <TextBox.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="20"/></Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Border>

                    <!-- Message statut -->
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="16" FontWeight="Medium"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource KioskBrownBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource KioskErrorBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Bouton Démarrer -->
                    <Button Command="{Binding ConnectCommand}" MinHeight="64"
                            Style="{StaticResource KioskPrimaryButton}" FontSize="20" Padding="24,14">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Démarrer  ›"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Text" Value="Chargement..."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                </StackPanel>
            </Border>

            <!-- Contact loueur -->
            <StackPanel HorizontalAlignment="Center" Margin="0,28,0,0">
                <TextBlock FontSize="16" Foreground="{StaticResource KioskBrownBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Code non reçu ? Contactez votre loueur de photobooth."/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasContactPhone}" Value="True">
                                    <Setter Property="Text" Value="Code non reçu ? Contactez votre loueur :"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"
                            Visibility="{Binding HasContactPhone, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource KioskForestBrush}">
                        <Run Text="{Binding ContactCompany, Mode=OneWay}"/><Run Text=" — "/><Run Text="📞 "/><Run Text="{Binding ContactPhone, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

        </StackPanel>

        <!-- ② Bouton Admin discret (coin haut droit) -->
        <Button Command="{Binding PinPad.OpenAdminPinCommand}"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="24" Width="64" Height="64"
                Focusable="False" IsTabStop="False"
                Style="{StaticResource KioskIconButton}"
                Visibility="{Binding PinPad.ShowPinEntry, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <Viewbox Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Fill="{StaticResource KioskForestBrush}"
                          Data="M12 1a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2h-1V6a5 5 0 0 0-5-5zm3 8H9V6a3 3 0 0 1 6 0v3z"/>
                </Canvas>
            </Viewbox>
        </Button>

        <!-- ③ Overlay saisie PIN avec pavé numérique -->
        <Border Background="{StaticResource KioskCreamBrush}" DataContext="{Binding PinPad}"
                Visibility="{Binding ShowPinEntry, Converter={StaticResource BoolToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="340">

                <TextBlock Text="Code administrateur"
                           Style="{StaticResource KioskTitleText}" FontSize="30"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Entrez le code PIN"
                           FontSize="16" Foreground="{StaticResource KioskBrownBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <!-- Affichage des points (un ● par chiffre saisi) -->
                <TextBlock Text="{Binding PinDots}"
                           FontSize="32" Foreground="{StaticResource KioskForestBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"
                           MinHeight="40"/>

                <!-- Erreur -->
                <TextBlock Text="{Binding PinError}"
                           FontSize="15" FontWeight="Medium" Foreground="{StaticResource KioskErrorBrush}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" Margin="0,0,0,16"
                           Visibility="{Binding HasPinError, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Pavé numérique 3×4 -->
                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <UniformGrid.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource KioskPadKey}"/>
                    </UniformGrid.Resources>

                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="1">
                        <TextBlock Text="1"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="2">
                        <TextBlock Text="2"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="3">
                        <TextBlock Text="3"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="4">
                        <TextBlock Text="4"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="5">
                        <TextBlock Text="5"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="6">
                        <TextBlock Text="6"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="7">
                        <TextBlock Text="7"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="8">
                        <TextBlock Text="8"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="9">
                        <TextBlock Text="9"/>
                    </Button>
                    <!-- Ligne basse : annuler / 0 / effacer -->
                    <Button Command="{Binding CloseAdminPinCommand}">
                        <TextBlock Text="✕" FontSize="22" Foreground="{StaticResource KioskBrownBrush}"/>
                    </Button>
                    <Button Command="{Binding AppendDigitCommand}" CommandParameter="0">
                        <TextBlock Text="0"/>
                    </Button>
                    <Button Command="{Binding DeleteDigitCommand}">
                        <TextBlock Text="⌫" FontSize="22"/>
                    </Button>
                </UniformGrid>

                <!-- Valider : le PIN fait 4 à 8 chiffres, sa longueur n'est pas connue d'avance -->
                <Button Command="{Binding ValidatePinCommand}" Height="72" Margin="6,0,6,0"
                        Style="{StaticResource KioskPrimaryButton}" Padding="0">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Valider"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecking}" Value="True">
                                        <Setter Property="Text" Value="Vérification..."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>
