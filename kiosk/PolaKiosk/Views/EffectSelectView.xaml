<UserControl x:Class="PolaKiosk.Views.EffectSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PolaKiosk.Converters">
    <UserControl.Resources>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
    </UserControl.Resources>
    <Grid Background="{StaticResource KioskCreamBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- ① Prévisualisation de la photo avec le filtre sélectionné -->
        <Border Grid.Column="0" Margin="24" CornerRadius="16" ClipToBounds="True">
            <Image Source="{Binding PreviewImage}"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Border>

        <!-- ② Panneau de sélection des filtres -->
        <Grid Grid.Column="1" Background="{StaticResource KioskCreamDarkBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <StackPanel Grid.Row="0" Margin="20,24,20,16">
                <TextBlock Text="Choisir un filtre" Style="{StaticResource KioskTitleText}"
                           FontSize="26"/>
                <TextBlock Text="Touchez un filtre pour prévisualiser" TextWrapping="Wrap"
                           FontSize="14" Foreground="{StaticResource KioskBrownBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Liste des filtres -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Effects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectEffectCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand" Margin="12,4">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="12" Padding="12,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource KioskPaperBrush}"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                    <Binding/>
                                                                    <Binding Path="DataContext.SelectedEffect"
                                                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Background" Value="{StaticResource KioskMintBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource KioskForestBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="56" Height="56"
                                                        CornerRadius="8" ClipToBounds="True">
                                                    <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                           FontSize="16" FontWeight="SemiBold"
                                                           Foreground="{StaticResource KioskForestBrush}"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Bouton Valider -->
            <Button Grid.Row="2" Command="{Binding ConfirmCommand}"
                    Style="{StaticResource KioskPrimaryButton}" FontSize="18" Padding="16,14"
                    Margin="12,8,12,20" MinHeight="64">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Valider ce filtre ✓"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsApplying}" Value="True">
                                    <Setter Property="Text" Value="Application..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
        </Grid>

    </Grid>
</UserControl>
