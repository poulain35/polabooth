<UserControl x:Class="PolaKiosk.Views.EventLoadingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource KioskCreamBrush}">

        <!-- ── Éléments décoratifs flottants ── -->

        <!-- 📸 Haut gauche -->
        <TextBlock Text="📸" FontSize="64" Opacity="0.55"
                   VerticalAlignment="Top" HorizontalAlignment="Left"
                   Margin="160,110,0,0">
            <TextBlock.RenderTransform><TranslateTransform x:Name="F1"/></TextBlock.RenderTransform>
        </TextBlock>

        <!-- ⚡ Haut droite -->
        <TextBlock Text="⚡" FontSize="52" Opacity="0.45"
                   VerticalAlignment="Top" HorizontalAlignment="Right"
                   Margin="0,90,180,0">
            <TextBlock.RenderTransform><TranslateTransform x:Name="F2"/></TextBlock.RenderTransform>
        </TextBlock>

        <!-- 🖼️ Milieu gauche -->
        <TextBlock Text="🖼️" FontSize="48" Opacity="0.40"
                   VerticalAlignment="Center" HorizontalAlignment="Left"
                   Margin="80,-80,0,0">
            <TextBlock.RenderTransform><TranslateTransform x:Name="F3"/></TextBlock.RenderTransform>
        </TextBlock>

        <!-- ✨ Milieu droite -->
        <TextBlock Text="✨" FontSize="44" Opacity="0.45"
                   VerticalAlignment="Center" HorizontalAlignment="Right"
                   Margin="0,60,100,0">
            <TextBlock.RenderTransform><TranslateTransform x:Name="F4"/></TextBlock.RenderTransform>
        </TextBlock>

        <!-- 🎉 Bas gauche -->
        <TextBlock Text="🎉" FontSize="50" Opacity="0.40"
                   VerticalAlignment="Bottom" HorizontalAlignment="Left"
                   Margin="200,0,0,130">
            <TextBlock.RenderTransform><TranslateTransform x:Name="F5"/></TextBlock.RenderTransform>
        </TextBlock>

        <!-- 🌟 Bas droite -->
        <TextBlock Text="🌟" FontSize="42" Opacity="0.38"
                   VerticalAlignment="Bottom" HorizontalAlignment="Right"
                   Margin="0,0,160,110">
            <TextBlock.RenderTransform><TranslateTransform x:Name="F6"/></TextBlock.RenderTransform>
        </TextBlock>

        <!-- ── Carte centrale ── -->
        <Border x:Name="Card"
                Style="{StaticResource KioskTile}" Padding="0"
                Width="580" VerticalAlignment="Center" HorizontalAlignment="Center"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardSlide"/>
            </Border.RenderTransform>

            <StackPanel Margin="52,48">

                <!-- Label -->
                <TextBlock Text="CHARGEMENT DE L'ÉVÉNEMENT"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource KioskBrownBrush}"
                           Margin="0,0,0,20"
                           TextOptions.TextRenderingMode="ClearType"/>

                <!-- Nom de l'événement -->
                <TextBlock Text="{Binding EventName}"
                           Style="{StaticResource KioskTitleText}" FontSize="36"
                           Margin="0,0,0,16"
                           TextOptions.TextRenderingMode="ClearType"/>

                <!-- Message -->
                <TextBlock FontSize="17" Foreground="{StaticResource KioskBrownBrush}"
                           TextWrapping="Wrap" LineHeight="26"
                           Margin="0,0,0,40"
                           TextOptions.TextRenderingMode="ClearType">
                    Vous allez bientôt pouvoir profiter de votre photobooth
                    et capturer vos premiers souvenirs. Quelques instants encore…
                </TextBlock>

                <!-- Trois points animés -->
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="11" Height="11" Fill="{StaticResource KioskForestBrush}" Margin="0,0,8,0">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="DS1" CenterX="5.5" CenterY="5.5"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="11" Height="11" Fill="{StaticResource KioskSageBrush}" Margin="0,0,8,0">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="DS2" CenterX="5.5" CenterY="5.5"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="11" Height="11" Fill="{StaticResource KioskBlushBrush}">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="DS3" CenterX="5.5" CenterY="5.5"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </StackPanel>

            </StackPanel>
        </Border>

    </Grid>

    <!-- ── Animations ── -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>

                    <!-- Entrée de la carte (fade + slide) -->
                    <DoubleAnimation Storyboard.TargetName="Card"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5"/>
                    <DoubleAnimation Storyboard.TargetName="CardSlide"
                                     Storyboard.TargetProperty="Y"
                                     From="24" To="0" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Flottement — élément 1 (📸) -->
                    <DoubleAnimation Storyboard.TargetName="F1" Storyboard.TargetProperty="Y"
                                     From="0" To="-20" Duration="0:0:2.2"
                                     AutoReverse="True" RepeatBehavior="Forever">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Flottement — élément 2 (⚡) -->
                    <DoubleAnimation Storyboard.TargetName="F2" Storyboard.TargetProperty="Y"
                                     From="0" To="-16" Duration="0:0:1.9"
                                     AutoReverse="True" RepeatBehavior="Forever"
                                     BeginTime="0:0:0.35">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Flottement — élément 3 (🖼️) -->
                    <DoubleAnimation Storyboard.TargetName="F3" Storyboard.TargetProperty="Y"
                                     From="0" To="-18" Duration="0:0:2.5"
                                     AutoReverse="True" RepeatBehavior="Forever"
                                     BeginTime="0:0:0.6">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Flottement — élément 4 (✨) -->
                    <DoubleAnimation Storyboard.TargetName="F4" Storyboard.TargetProperty="Y"
                                     From="0" To="-14" Duration="0:0:2.0"
                                     AutoReverse="True" RepeatBehavior="Forever"
                                     BeginTime="0:0:0.15">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Flottement — élément 5 (🎉) -->
                    <DoubleAnimation Storyboard.TargetName="F5" Storyboard.TargetProperty="Y"
                                     From="0" To="-22" Duration="0:0:2.8"
                                     AutoReverse="True" RepeatBehavior="Forever"
                                     BeginTime="0:0:0.8">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Flottement — élément 6 (🌟) -->
                    <DoubleAnimation Storyboard.TargetName="F6" Storyboard.TargetProperty="Y"
                                     From="0" To="-12" Duration="0:0:1.7"
                                     AutoReverse="True" RepeatBehavior="Forever"
                                     BeginTime="0:0:0.5">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- Dots — point 1 -->
                    <DoubleAnimation Storyboard.TargetName="DS1" Storyboard.TargetProperty="ScaleX"
                                     From="1" To="1.6" Duration="0:0:0.45"
                                     AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="DS1" Storyboard.TargetProperty="ScaleY"
                                     From="1" To="1.6" Duration="0:0:0.45"
                                     AutoReverse="True" RepeatBehavior="Forever"/>

                    <!-- Dots — point 2 -->
                    <DoubleAnimation Storyboard.TargetName="DS2" Storyboard.TargetProperty="ScaleX"
                                     From="1" To="1.6" Duration="0:0:0.45"
                                     AutoReverse="True" RepeatBehavior="Forever"
                                     BeginTime="0:0:0.15"/>
                    <DoubleAnimation Storyboard.TargetName="DS2" Storyboard.TargetProperty="ScaleY"
                                     From="1" To="1.6" Duration="0:0:0.45"
                                     AutoReverse="True" RepeatBehavior="Forever"
                                     BeginTime="0:0:0.15"/>

                    <!-- Dots — point 3 -->
                    <DoubleAnimation Storyboard.TargetName="DS3" Storyboard.TargetProperty="ScaleX"
                                     From="1" To="1.6" Duration="0:0:0.45"
                                     AutoReverse="True" RepeatBehavior="Forever"
                                     BeginTime="0:0:0.3"/>
                    <DoubleAnimation Storyboard.TargetName="DS3" Storyboard.TargetProperty="ScaleY"
                                     From="1" To="1.6" Duration="0:0:0.45"
                                     AutoReverse="True" RepeatBehavior="Forever"
                                     BeginTime="0:0:0.3"/>

                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

</UserControl>
