# Configuration d'une instance du SaaS photobooth, lue par « npm run install-instance ».
# Copiez ce fichier en « instance.env » (même dossier), remplissez-le, puis lancez le script.
# instance.env contient des mots de passe : ne le partagez pas, ne l'envoyez jamais sur Git.
# Format : NOM=valeur, une variable par ligne. Mettez la valeur entre guillemets simples
# si elle contient un espace, un # ou un $ (ex. SMTP_PASSWORD='mon#mot$de passe').
# Guide complet : docs/installation-instance.md

# ── Projet Supabase ──────────────────────────────────────────────────────────────────────────

# Identifiant du projet : les 20 lettres de l'adresse https://<identifiant>.supabase.co
# (tableau de bord Supabase > Project Settings > General > Project ID).
SUPABASE_PROJECT_REF=

# Mot de passe de la base de données, choisi à la création du projet
# (oublié : Project Settings > Database > Reset database password).
SUPABASE_DB_PASSWORD=

# ── SaaS ─────────────────────────────────────────────────────────────────────────────────────

# Adresse publique du SaaS, en https, sans chemin ni barre finale.
# C'est aussi l'adresse à saisir sur la borne.
APP_URL=https://photobooth.mon-entreprise.fr

# Nom de votre entreprise : nom de l'organisation et nom d'expéditeur des emails par défaut.
COMPANY_NAME=

# Téléphone affiché aux clients et sur la borne (facultatif, modifiable ensuite dans Paramètres).
COMPANY_PHONE=

# Email du compte administrateur. Le script crée ce compte et lui envoie une invitation.
ADMIN_EMAIL=

# ── Envoi des emails (SMTP) ──────────────────────────────────────────────────────────────────

# Serveur SMTP de votre messagerie (ex. smtp.ionos.fr, ssl0.ovh.net, smtp.gmail.com).
SMTP_HOST=

# Port SMTP en SSL/TLS. Laissez 465 : Supabase bloque les ports 25 et 587.
SMTP_PORT=465

# Identifiant SMTP, en général l'adresse email complète.
SMTP_USER=

# Mot de passe SMTP (ou mot de passe d'application, ex. chez Gmail).
SMTP_PASSWORD=

# Adresse d'expédition des emails envoyés aux clients. Elle doit être autorisée par votre SMTP.
FROM_EMAIL=

# Nom d'expéditeur affiché (facultatif ; vide = COMPANY_NAME).
FROM_NAME=

# ── Stockage des photos et des messages audio (compatible S3) ────────────────────────────────

# Adresse de l'API S3 du fournisseur (ex. Scaleway : https://s3.fr-par.scw.cloud ;
# OVHcloud : https://s3.gra.io.cloud.ovh.net ; Backblaze : https://s3.eu-central-003.backblazeb2.com).
STORAGE_ENDPOINT=

# Région du fournisseur (ex. fr-par, gra, eu-central-003). Vide = us-east-1.
STORAGE_REGION=

# Clé d'accès S3 (Access Key ID), créée chez le fournisseur.
STORAGE_ACCESS_KEY_ID=

# Clé secrète S3 (Secret Access Key), affichée une seule fois à sa création.
STORAGE_SECRET_ACCESS_KEY=

# Nom du bucket des médias (messages audio, et photos si STORAGE_PHOTOS_BUCKET est vide).
STORAGE_BUCKET=

# Adresse publique de lecture du bucket, sans barre finale
# (ex. Scaleway : https://<bucket>.s3.fr-par.scw.cloud).
STORAGE_PUBLIC_URL=

# Bucket séparé pour les photos (facultatif ; vide = STORAGE_BUCKET).
STORAGE_PHOTOS_BUCKET=

# Adresse publique du bucket des photos (facultatif ; à remplir si STORAGE_PHOTOS_BUCKET est rempli).
STORAGE_PHOTOS_PUBLIC_URL=

# Style des adresses S3 (facultatif) : vide ou true = endpoint/bucket/fichier (compris partout),
# false = bucket.endpoint/fichier.
STORAGE_FORCE_PATH_STYLE=
