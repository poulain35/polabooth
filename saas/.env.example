# ── Supabase ─────────────────────────────────────────────────────────────────
# Récupérer dans : Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173

# Fournisseur des emails, à aligner sur EMAIL_PROVIDER des edge functions (absent = Brevo).
# « smtp » : le suivi des emails (réception, ouvertures, clics) affiche « Suivi indisponible avec SMTP ».
# VITE_EMAIL_PROVIDER=smtp

# ── Variables pour les Edge Functions (configurer dans Supabase Dashboard) ───
# Supabase Dashboard > Edge Functions > Secrets
#
# SUPABASE_URL              = (auto-injecté par Supabase)
# SUPABASE_SERVICE_ROLE_KEY = (auto-injecté par Supabase)
# BREVO_API_KEY             = xkeysib-xxxxxxxxxxxxxxxxxxxx
# EMAIL_PROVIDER            = brevo | smtp (absent : Brevo ; SMTP s'il n'y a pas de clé Brevo et que SMTP_HOST est défini)
# SMTP_HOST                 = smtp.exemple.fr (envoi SMTP, sans suivi des emails)
# SMTP_PORT                 = 465 (défaut ; Supabase bloque les ports sortants 25 et 587)
# SMTP_USER                 = identifiant SMTP
# SMTP_PASSWORD             = mot de passe SMTP
#
# Stockage des médias (photos, messages audio). Sans STORAGE_ENDPOINT : Cloudflare R2.
# R2_ACCOUNT_ID             = identifiant du compte Cloudflare
# R2_ACCESS_KEY_ID          = clé d'accès R2
# R2_SECRET_ACCESS_KEY      = secret R2
# R2_BUCKET_NAME            = bucket audio (et photos à défaut)
# R2_PHOTOS_BUCKET_NAME     = bucket photos
# R2_PUBLIC_URL             = https://pub-xxxx.r2.dev (lecture publique du bucket audio)
# R2_PHOTOS_PUBLIC_URL      = https://pub-yyyy.r2.dev (lecture publique du bucket photos)
# Avec STORAGE_ENDPOINT : tout fournisseur compatible S3 (Scaleway, OVH, Backblaze, MinIO, Supabase Storage…),
# les R2_* sont ignorées. CORS du bucket : origine du SaaS, méthodes PUT et GET (voir saas/CLAUDE.md).
# STORAGE_ENDPOINT          = https://s3.fr-par.scw.cloud
# STORAGE_REGION            = fr-par (défaut : us-east-1)
# STORAGE_ACCESS_KEY_ID     = clé d'accès S3
# STORAGE_SECRET_ACCESS_KEY = secret S3
# STORAGE_FORCE_PATH_STYLE  = true (défaut ; false pour des URL bucket.endpoint)
# STORAGE_BUCKET            = medias (audio, et photos à défaut)
# STORAGE_PHOTOS_BUCKET     = (facultatif) bucket photos
# STORAGE_PUBLIC_URL        = https://medias.s3.fr-par.scw.cloud (base publique de lecture, sans slash final)
# STORAGE_PHOTOS_PUBLIC_URL = (facultatif) base publique du bucket photos
#
# FROM_EMAIL                = noreply@exemple.fr
# FROM_NAME                 = Nom de votre entreprise
# APP_URL                   = https://votre-domaine.com
